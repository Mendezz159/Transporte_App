<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F5F7"
    tools:context=".ProfileActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Loading View -->
        <LinearLayout
            android:id="@+id/layoutLoading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="40dp"
            android:visibility="visible">

            <ProgressBar
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cargando datos del perfil..."
                android:textSize="16sp"
                android:textColor="#666666" />
        </LinearLayout>

        <!-- Error State View -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:visibility="gone"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFEBEE">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:gravity="center_horizontal">

                <TextView
                    android:id="@+id/tvErrorTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Error al consultar el perfil"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#C62828" />

                <TextView
                    android:id="@+id/tvErrorMessage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:textSize="14sp"
                    android:textColor="#B71C1C"
                    tools:text="No se pudo conectar al servidor. Verifica la URL base en Constants.kt" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRetry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Reintentar"
                    app:cornerRadius="8dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Content Container -->
        <LinearLayout
            android:id="@+id/layoutContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <!-- Profile Header Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:padding="24dp">

                    <!-- Avatar Icon / Initial -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        app:cardCornerRadius="40dp"
                        app:cardBackgroundColor="#3F51B5"
                        app:cardElevation="0dp">

                        <TextView
                            android:id="@+id/tvAvatarInitial"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="U"
                            android:textColor="#FFFFFF"
                            android:textSize="36sp"
                            android:textStyle="bold" />
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/tvHeaderName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#1D1B20"
                        tools:text="QA Editado Tester" />

                    <TextView
                        android:id="@+id/tvHeaderEmail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textSize="14sp"
                        android:textColor="#666666"
                        tools:text="test30@gmail.com" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Personal Data Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:text="Información Personal"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#1D1B20" />

                    <!-- Nombre -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nombre"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#5F6368" />

                    <TextView
                        android:id="@+id/tvNombre"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:textSize="15sp"
                        android:textColor="#1D1B20"
                        tools:text="QA Editado" />

                    <!-- Apellido -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Apellido"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#5F6368" />

                    <TextView
                        android:id="@+id/tvApellido"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:textSize="15sp"
                        android:textColor="#1D1B20"
                        tools:text="Tester" />

                    <!-- Correo -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Correo Electrónico"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#5F6368" />

                    <TextView
                        android:id="@+id/tvCorreo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:textSize="15sp"
                        android:textColor="#1D1B20"
                        tools:text="test30@gmail.com" />

                    <!-- Teléfono -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Teléfono"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#5F6368" />

                    <TextView
                        android:id="@+id/tvTelefono"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:textSize="15sp"
                        android:textColor="#1D1B20"
                        tools:text="3000000000" />

                    <!-- Nacionalidad -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nacionalidad"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#5F6368" />

                    <TextView
                        android:id="@+id/tvNacionalidad"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:textSize="15sp"
                        android:textColor="#1D1B20"
                        tools:text="Colombia" />

                    <!-- Fecha de Nacimiento -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Fecha de Nacimiento"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#5F6368" />

                    <TextView
                        android:id="@+id/tvFechaNacimiento"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="15sp"
                        android:textColor="#1D1B20"
                        tools:text="1985-06-20" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Account Identification Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:text="Detalles del Sistema"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#1D1B20" />

                    <!-- UID -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="UID (Firebase)"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#5F6368" />

                    <TextView
                        android:id="@+id/tvUid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:textSize="13sp"
                        android:textColor="#1D1B20"
                        android:textIsSelectable="true"
                        tools:text="mdXW0aoFp3dCis7gGvLBzTpHFBy1" />

                    <!-- ID MongoDB -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ID Base de Datos (_id)"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#5F6368" />

                    <TextView
                        android:id="@+id/tvDbId"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:textSize="13sp"
                        android:textColor="#1D1B20"
                        android:textIsSelectable="true"
                        tools:text="6821f292d15f04a1e5aec8b1" />

                    <!-- Creado en -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Fecha de Creación"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#5F6368" />

                    <TextView
                        android:id="@+id/tvCreatedAt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:textSize="13sp"
                        android:textColor="#1D1B20"
                        tools:text="2025-05-12T13:07:35.436Z" />

                    <!-- Actualizado en -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Última Actualización"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#5F6368" />

                    <TextView
                        android:id="@+id/tvUpdatedAt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:textColor="#1D1B20"
                        tools:text="2026-10-23T22:55:46.364Z" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Raw JSON View Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Respuesta JSON Completa"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#1D1B20" />

                    <TextView
                        android:id="@+id/tvProfileRawJson"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textSize="11sp"
                        android:fontFamily="monospace"
                        android:textColor="#333333"
                        android:background="#ECEFF1"
                        android:padding="10dp"
                        android:textIsSelectable="true"
                        tools:text="{ &quot;user&quot;: { &quot;nombre&quot;: &quot;QA Editado&quot; } }" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Logout Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogout"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="Cerrar Sesión"
                android:textColor="#C62828"
                android:textSize="16sp"
                android:textStyle="bold"
                app:strokeColor="#C62828"
                app:cornerRadius="12dp" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
